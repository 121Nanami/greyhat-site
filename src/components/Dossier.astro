---
import { site } from '../lib/content';
---

<section class="dossier" aria-labelledby="operator-title">
  <p class="dossier-stamp">GH-BNE · PUBLIC FILE · NO ANALYTICS</p>
  <h2 id="operator-title">Operator file</h2>
  <dl class="dossier-list">
    <div>
      <dt>Name</dt>
      <dd>{site.person}</dd>
    </div>
    <div>
      <dt>Role</dt>
      <dd>{site.role}</dd>
    </div>
    <div>
      <dt>Studio</dt>
      <dd>{site.studio}</dd>
    </div>
    <div>
      <dt>Place</dt>
      <dd>{site.place}</dd>
    </div>
    <div>
      <dt>Focus</dt>
      <dd>{site.focus}</dd>
    </div>
    <div>
      <dt>Ethos</dt>
      <dd>{site.ethos}</dd>
    </div>
  </dl>
  <p class="dossier-foot">AI Colosseum is active: Fitness trains the roster, Arena runs the races. Both repositories are private and are not linked.</p>
</section>
