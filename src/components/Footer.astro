---
import { href } from '../lib/href';
import { projects, site } from '../lib/content';

const seen = new Set<string>();
const socials = [...(site.socials ?? []), ...projects.flatMap((project) => project.links ?? [])].filter((link) => {
  if (seen.has(link.href)) return false;
  seen.add(link.href);
  return true;
});
---

<footer class="footer">
  <div class="wrap footer-inner">
    <p>
      <a href={href('/')}>{site.studio}</a>
      · AI engineering studio
      · {site.place}
    </p>
    {
      socials.length > 0 && (
        <ul class="socials">
          {socials.map((link) => (
            <li>
              <a href={link.href} rel="noopener noreferrer">{link.label}</a>
            </li>
          ))}
        </ul>
      )
    }
    <p>
      Agent Arena, Agent Fitness, FiaOS, and BoldInBeauty are private and are not linked.
      No analytics. Fonts and images ship with the site. Outbound links are the GitHub profile, the public GATE and GreyHat repositories, the GATE pages site, and the AI Colosseum YouTube channel.
    </p>
    <p class="footer-meta">bne · session public · local only</p>
  </div>
</footer>
