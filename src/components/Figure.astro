---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  n: number;
  eager?: boolean;
}

const { src, alt, caption, n, eager = false } = Astro.props;
const tall = src.height / src.width > 1.02;
const widths = [...new Set([640, 960, 1280, 1600].filter((width) => width < src.width).concat(src.width))].sort(
  (a, b) => a - b,
);
const number = String(n).padStart(2, '0');
---

<figure class="figure">
  <div class:list={['figure-frame', { scroll: tall }]} tabindex={tall ? 0 : undefined} aria-label={tall ? 'Scrollable screenshot' : undefined}>
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes="(min-width: 1100px) 960px, 100vw"
      quality={82}
      format="webp"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : undefined}
    />
  </div>
  {
    tall && (
      <p class="scroll-hint">
        <span>Scroll inside the frame for the full capture.</span>
      </p>
    )
  }
  <figcaption>
    <span class="fig-n">Fig. {number}</span>
    {caption}
  </figcaption>
</figure>
