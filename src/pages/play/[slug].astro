---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projects } from '../../lib/content';
import { href } from '../../lib/href';
import { imageFor } from '../../lib/images';
import { DEMO_KIND, RAW_APP } from '../../scripts/play-meta.mjs';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const kind = DEMO_KIND[project.slug];
const raw = RAW_APP[project.slug];
const label =
  kind === 'replay'
    ? 'Replay of recorded run.'
    : kind === 'gallery'
      ? 'Public stills, plus the browser demo on this page.'
      : 'Runs in this browser. No server.';
---

<Base frame title={`Play ${project.title} — GreyHat Inc`} description={`${label} ${project.title}. ${project.summary}`}>
  <div class="play-shell">
    <header class="play-bar">
      <a href={href(`projects/${project.slug}/`)}>Back</a>
      <h1>{project.title}</h1>
      {
        raw ? (
          <a href={href(raw)}>Open full screen</a>
        ) : (
          <a href={href(`play/${project.slug}/`)} target="_blank" rel="noopener">Open full screen</a>
        )
      }
    </header>
    {
      kind === 'gallery' && project.shots.length > 0 && (
        <div class="play-gallery">
          {project.shots.map((shot) => (
            <figure>
              <Image src={imageFor(shot.file)} alt={shot.alt} widths={[640, 960]} sizes="100vw" format="webp" />
              <figcaption>{shot.caption}</figcaption>
            </figure>
          ))}
        </div>
      )
    }
    <div id="demo" class="play-stage" data-slug={project.slug} data-kind={kind}></div>
  </div>
</Base>

<script>
  import { mount } from '../../scripts/demos.mjs';
  mount(document.getElementById('demo'));
</script>
