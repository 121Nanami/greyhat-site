---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projects } from '../../lib/content';
import { href } from '../../lib/href';
import { imageFor } from '../../lib/images';
import { DEMO_KIND } from '../../scripts/play-meta.mjs';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const kind = DEMO_KIND[project.slug];
const label =
  kind === 'replay'
    ? 'Replay of recorded run.'
    : kind === 'gallery'
      ? 'Gallery of public stills. The control below is a browser demo, not a recorded match.'
      : 'Browser demo. It runs in this page and does not call a server.';
---

<Base title={`Play ${project.title} — GreyHat Inc`} description={`${label} ${project.title}. ${project.summary}`}>
  <article class="wrap play">
    <p class="crumbs">
      <a href={href('/')}>Session</a>
      <span aria-hidden="true">/</span>
      <a href={href(`projects/${project.slug}/`)}>{project.title}</a>
      <span aria-hidden="true">/</span>
      <span>Play</span>
    </p>
    <header class="report-head">
      <p class="kicker">{kind}</p>
      <h1>{project.title}</h1>
      <p class="lede">{label}</p>
    </header>
    {
      kind === 'gallery' && project.shots.length > 0 && (
        <div class="play-gallery">
          {project.shots.map((shot) => (
            <figure>
              <Image src={imageFor(shot.file)} alt={shot.alt} widths={[640, 960, 1280]} sizes="(min-width: 800px) 720px, 100vw" format="webp" />
              <figcaption>{shot.caption}</figcaption>
            </figure>
          ))}
        </div>
      )
    }
    <div id="demo" data-slug={project.slug} data-kind={kind}></div>
  </article>
</Base>

<script>
  import { mount } from '../../scripts/demos.mjs';
  mount(document.getElementById('demo'));
</script>
