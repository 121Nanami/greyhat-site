{
  "name": "greyhat-inc",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0 --port 4471",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-dist.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0 --port 4471",
    "check": "node scripts/check-content.mjs",
    "test": "node --test scripts/terminal.test.mjs",
    "test:play": "playwright test",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
